# Copia este archivo como .env en el servidor (chmod 600 .env) y reemplaza TODOS los valores.
# Nunca subas el .env real al repositorio.

# ─── Dominio y HTTPS ──────────────────────────────────────────────────────
# Dominio público con un registro DNS A apuntando a la IP del VPS.
DOMAIN=stayhub.tu-dominio.com
# Correo para Let's Encrypt (avisos de vencimiento de certificados).
ACME_EMAIL=tu-correo@tu-dominio.com

# ─── PostgreSQL ───────────────────────────────────────────────────────────
DATABASE_USER=lr_user
# Genera una clave larga: openssl rand -base64 32
DATABASE_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA
DATABASE_NAME=inversiones_lr_db
DATABASE_SCHEMA=stayhub

# ─── Administrador inicial (solo se crea en el primer arranque) ───────────
ADMIN_INITIAL_NAME=Administrador Inversiones LR
ADMIN_INITIAL_EMAIL=admin@tu-dominio.com
# Mínimo 12 caracteres, con letras y números. Cámbiala desde la app tras el primer ingreso.
ADMIN_INITIAL_PASSWORD=CAMBIAR_CLAVE_ADMIN_2026

# ─── Correo SMTP (obligatorio: recuperación de contraseña y notificaciones) ─
# Ejemplos: Brevo smtp-relay.brevo.com:587 · SendGrid smtp.sendgrid.net:587 ·
# Gmail smtp.gmail.com:465 con SMTP_SECURE=true y una contraseña de aplicación.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Inversiones LR <no-reply@tu-dominio.com>

# ─── Opcionales ───────────────────────────────────────────────────────────
# Identificación ante Nominatim (geocodificación del mapa).
GEOCODING_USER_AGENT=StayHub/1.0 (tu-correo@tu-dominio.com)
SESSION_TIMEOUT_MINUTES=60
RATE_LIMIT_PER_MINUTE=300
ENABLE_SWAGGER=false
SEED_DEMO_DATA=false
