# ─── General ──────────────────────────────────────────────────────────────
# development | production. En production el arranque falla si falta
# configuración obligatoria o si se usan las credenciales de este archivo.
NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS, separados por comas (obligatorio en producción).
CORS_ORIGINS=http://localhost:4200
# Swagger en /api/docs. Por defecto: activo en desarrollo, desactivado en producción.
# ENABLE_SWAGGER=false
# Peticiones por minuto por IP (login: 10/min, recuperación: 20/min).
RATE_LIMIT_PER_MINUTE=300
# Proxies de confianza para obtener la IP real (X-Forwarded-For).
# TRUST_PROXY=loopback, linklocal, uniquelocal
# Publicaciones de ejemplo. Por defecto: activas en desarrollo, desactivadas en producción.
# SEED_DEMO_DATA=false

# ─── PostgreSQL ───────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=lr_user
DATABASE_PASSWORD=lr_password123
DATABASE_NAME=inversiones_lr_db
DATABASE_SCHEMA=stayhub
# true para bases administradas que exigen TLS.
DATABASE_SSL=false
DATABASE_CONNECT_RETRIES=10
DATABASE_CONNECT_DELAY_MS=1000
# No usar false fuera de pruebas: sin persistencia se pierde todo al reiniciar.
PERSIST_STATE=true

# ─── Sesiones y administrador inicial ─────────────────────────────────────
SESSION_TIMEOUT_MINUTES=60
# Solo se usa en el primer arranque (si no existe ningún administrador).
ADMIN_INITIAL_NAME=Administrador Inversiones LR
ADMIN_INITIAL_EMAIL=admin@inversioneslr.com
ADMIN_INITIAL_PASSWORD=AdminLr2026!

# ─── Recuperación de contraseña y correo (HU-004 / HU-004A) ───────────────
APP_BASE_URL=http://localhost:4200
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RECOVERY_MAX_REQUESTS=3
# Vacío = buzón simulado (solo desarrollo). Obligatorio en producción.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true y una contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Inversiones LR <no-reply@inversioneslr.com>

# ─── Imágenes de publicaciones ────────────────────────────────────────────
# Carpeta de subida (en Docker: /app/uploads, montada como volumen).
# UPLOADS_DIR=./uploads

# ─── Geocodificación (mapa) ───────────────────────────────────────────────
# Por defecto usa Nominatim público (1 petición/s). Identifícate con un User-Agent propio.
# GEOCODING_MODE=
# GEOCODING_API_URL=https://nominatim.openstreetmap.org/search
# GEOCODING_USER_AGENT=StayHub/1.0 (contacto@tu-dominio.com)
# GEOCODING_TIMEOUT_MS=5000

# ─── Reservas ─────────────────────────────────────────────────────────────
# Cierre diario automático de estadías (proceso interno). false para desactivarlo.
BOOKING_DAILY_CLOSURE=true

# ─── Pagos (HU-037) ───────────────────────────────────────────────────────
# Solo modo de pruebas: nunca claves sk_live_/pk_live_/prv_prod_.
PAYMENT_MODE=test
PAYMENT_SECRET_KEY=sk_test_stayhub_sandbox
